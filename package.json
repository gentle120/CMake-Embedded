{
  "name": "cmake-embedded",
  "displayName": "CMake-Embedded",
  "description": "Generate ready-to-build CMake projects for MCU firmware and for Linux / SoC cross compilation.",
  "version": "2.0.5",
  "publisher": "gentle120",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentle120/CMake-Embedded.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "extensionDependencies": [
    "ms-vscode.cmake-tools",
    "ms-vscode.cpptools"
  ],
  "main": "./out/extension.js",
  "icon": "images/icon-electric.png",
  "contributes": {
    "commands": [
      {
        "command": "cmakeEmbedded.generateMcu",
        "title": "CMake-Embedded: Generate MCU Project"
      },
      {
        "command": "cmakeEmbedded.generateLinux",
        "title": "CMake-Embedded: Generate Linux Project"
      },
      {
        "command": "cmakeEmbedded.generateFlashScript",
        "title": "CMake-Embedded: Generate OpenOCD Flash Script"
      },
      {
        "command": "cmakeEmbedded.generateDebugConfiguration",
        "title": "CMake-Embedded: Generate Cortex-Debug Configuration"
      }
    ],
    "configuration": {
      "title": "CMake-Embedded",
      "properties": {
        "cmakeEmbedded.openocdPath": {
          "type": "string",
          "default": "openocd",
          "description": "Path to the OpenOCD executable. Use openocd when it is available in PATH."
        },
        "cmakeEmbedded.armToolchainPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ARM GNU Toolchain bin directory used by Cortex-Debug."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('out',{recursive:true,force:true})\"",
    "compile": "npm run clean && tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
