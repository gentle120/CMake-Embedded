{
  "name": "cmake-embedded",
  "displayName": "CMake-Embedded",
  "description": "Generate a CMake build project for MCU firmware.",
  "version": "2.0.1",
  "publisher": "gentle120",
  "repository": {
    "type": "git",
    "url": "https://github.com/gentle120/CMake-Embedded.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:mcuCmake.generate",
    "onCommand:mcuCmake.generateFlashScript",
    "onCommand:mcuCmake.generateDebugConfiguration"
  ],
  "extensionDependencies": [
    "ms-vscode.cmake-tools",
    "ms-vscode.cpptools",
    "marus25.cortex-debug"
  ],
  "main": "./out/extension.js",
  "icon": "images/icon-electric.png",
  "contributes": {
    "commands": [
      {
        "command": "mcuCmake.generate",
        "title": "CMake-Embedded: Generate Project"
      },
      {
        "command": "mcuCmake.generateFlashScript",
        "title": "CMake-Embedded: Generate OpenOCD Flash Script"
      },
      {
        "command": "mcuCmake.generateDebugConfiguration",
        "title": "CMake-Embedded: Generate Cortex-Debug Configuration"
      }
    ],
    "configuration": {
      "title": "CMake-Embedded",
      "properties": {
        "mcuCmake.openocdPath": {
          "type": "string",
          "default": "openocd",
          "description": "Path to the OpenOCD executable. Use openocd when it is available in PATH."
        },
        "mcuCmake.armToolchainPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ARM GNU Toolchain bin directory used by Cortex-Debug."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node --test out/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.7.0"
  }
}
